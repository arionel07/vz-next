# Required for all server-side catalog, checkout, account and sitemap queries.
DATABASE_URL=mysql://vizaje:change_me_password@127.0.0.1:3307/vizaje_nica

# Public canonical origin. Use the production domain on the VPS.
NEXT_PUBLIC_SITE_URL=https://vizaje-nica.com

# Resend: authentication, contact notifications, subscription welcome email,
# order confirmation and registration welcome email.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional: CC address for order-confirmation emails (admin copy of every
# order, mirrors legacy's ORDER_EMAIL cc in Cart::email_order()). Leave empty
# to send the customer confirmation only.
ORDER_NOTIFICATION_EMAIL=

# SMS provider used by login and registration flows.
SMS_API_URL=https://messages.inter-mob.com/sms.asp
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=Vizaje-Nica

# Analytics are loaded only after the matching cookie consent is stored.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# Optional Meilisearch read provider. MySQL remains the automatic fallback.
MEILISEARCH_URL=
MEILISEARCH_INDEX=vizaje_nica_products
MEILISEARCH_SEARCH_KEY=
MEILISEARCH_TIMEOUT_MS=2000
# Admin-only: health/stats/settings/tasks/reindex at /admin/search. Never
# sent to the browser — do not reuse the search (public) key here.
MEILISEARCH_ADMIN_KEY=

# Files from the legacy installation, mounted outside this Next.js project.
LEGACY_ASSET_ROOT=

# WorkApp/1C: shared HTTP client only (src/lib/workapp-client.ts). Mirrors
# legacy's observed contract (docs/workapp-1c-observed-contract.md) —
# same plain-HTTP endpoint, same lack of authentication by default.
# WORKAPP_ENABLED=true turns on the customer sync: Discount/Bonus are pulled
# into `clients` after login, and contact data is pushed after registration
# and profile save. With false, no request leaves the app.
WORKAPP_ENABLED=false
WORKAPP_BASE_URL=http://api.vizaje-nica.com:90/Vizaje-Nica/hs/WORKAPP
WORKAPP_AUTH_TOKEN=
WORKAPP_TIMEOUT_MS=10000
WORKAPP_MAX_RETRIES=2

# Orders -> 1C export/ack (src/lib/one-c-orders.ts, /api/integrations/1c/orders).
# Bearer token 1C must send as "Authorization: Bearer <token>". Unset means
# the endpoints always reject (fail-closed). Generate with e.g.
# `openssl rand -hex 32` — never reuse legacy's hardcoded credentials.
ONE_C_ORDERS_TOKEN=

# Paynet (paynet.md) online card payment. PAYNET_ENABLED=false means the
# "online" checkout option returns 503 and the webhook is a no-op — fail
# closed, same pattern as WORKAPP_ENABLED.
#
# SECURITY: legacy's merchant credentials (application/libraries/paynet/
# paynet/PaynetConfig.php) were hardcoded in plaintext and committed to
# git/GitHub. Rotate them with Paynet before using them here — never reuse
# a credential that has been exposed in version control.
PAYNET_ENABLED=false
PAYNET_MERCHANT_CODE=
PAYNET_MERCHANT_SECRET_KEY=
PAYNET_MERCHANT_USER=
PAYNET_MERCHANT_USER_PASSWORD=
# Defaults to the production endpoints; Paynet's test environment (ask
# Paynet for the current test.paynet.md hostnames) can be set here for
# sandbox testing before going live.
PAYNET_API_BASE_URL=https://ecom-api.paynet.md
PAYNET_FORM_BASE_URL=https://paynet.md/acquiring/setecom
